# Copy to .env and fill in locally. Never commit .env.
# A WeatherXM Pro API key is created in the Pro console (API Management).
# This prototype has no key checked in, and no BeltLine stations to query yet.

WEATHERXM_API_KEY=
WEATHERXM_API_BASE_URL=https://pro.weatherxm.com/api/v1

# Comma-separated WeatherXM station UUIDs. Leave empty until host sites exist.
# The ingest will not guess stations from a map bounding box.
WEATHERXM_STATION_IDS=

# Optional label applied at ingest time: eastside or westside.
# Leave unset so unrelated stations are not tagged as BeltLine sites.
WEATHERXM_SEGMENT=

# Drop observations below this WeatherXM data-quality score (0 to 1).
# 0 accepts every observation, including those with no score.
# A threshold above 0 also drops observations that have no score.
QOD_MIN_SCORE=0

# Local docker-compose default. Omit to run the API against the in-memory store.
DATABASE_URL=postgresql://beltline:beltline@localhost:5432/beltline

# Streamr bridge. Dry-run is the default and publishes nothing.
# STREAMR_PRIVATE_KEY is the stream owner's Ethereum key. Never commit it.
# A live run can create streams on Polygon and needs POL for gas.
STREAMR_DRY_RUN=1
STREAMR_PRIVATE_KEY=
# Example shapes only. These are not streams that exist:
#   /open-depin-telemetry
#   0x<your-address>/open-depin-telemetry
STREAMR_STREAM_ID_PREFIX=
STREAMR_POLL_INTERVAL_MS=60000
STREAMR_ONCE=0
STREAMR_SAMPLE=0
# Leave at 0 until WeatherXM's terms have been checked for a public mirror.
STREAMR_ALLOW_PUBLIC_WEATHERXM=0
# weatherxm is implemented. geodnet, wingbits, helium, and air-quality are stubs.
STREAMR_ADAPTERS=weatherxm
# Local read API used by the bridge. The compose service sets this for you.
# BELTLINE_API_URL=http://127.0.0.1:8000
# auto uses whichever of the local API and the Pro API is configured.
WEATHERXM_SOURCE=auto
